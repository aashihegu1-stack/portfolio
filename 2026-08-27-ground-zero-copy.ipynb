        "        <div class=\"lesson-header\">\n",
        "          <h1>Onboarding Challenge - Ground 0</h1>\n",
        "          <div class=\"lesson-meta\">\n",
        "            <span><i class=\"fas fa-clock\"></i> <span class=\"read-time\">18 min read</span></span>\n",
